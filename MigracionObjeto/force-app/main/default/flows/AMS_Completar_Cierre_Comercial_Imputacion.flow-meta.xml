            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;padding: 10px 0; border-bottom: 1px solid #e0e0e0;&quot;&gt;&lt;strong&gt;Fecha de Registro:&lt;/strong&gt;&lt;/td&gt;
