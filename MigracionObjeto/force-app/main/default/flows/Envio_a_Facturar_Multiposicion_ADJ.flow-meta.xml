  &quot;&lt;table border=&apos;1&apos; cellpadding=&apos;8&apos; cellspacing=&apos;0&apos; style=&apos;border-collapse:collapse;width:100%;table-layout:fixed;word-wrap:break-word;border:1px solid #ddd;&apos;&gt;&quot; &amp;
    &quot;&lt;tr&gt;&quot; &amp;
