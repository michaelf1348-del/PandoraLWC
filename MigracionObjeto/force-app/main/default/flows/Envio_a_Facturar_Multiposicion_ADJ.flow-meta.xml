    <formulas>
        <name>fasunto</name>
        <dataType>String</dataType>
        <expression>&quot;AMS Solicitud de facturación &quot; &amp;
BLANKVALUE({!$Record.Cliente__r.Name}, &quot;-&quot;) &amp;
IF(
  BLANKVALUE({!$Record.Total_Reenvios__c}, 0) &gt; 0,
  &quot; – Reenvío&quot;,
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fCabecera</name>
        <dataType>String</dataType>
        <expression>&quot;Buen día, estimado(a):&lt;br/&gt;&lt;br/&gt;&quot; &amp;
&quot;Por favor proceder a emitir facturación al cliente &quot; &amp;
BLANKVALUE({!$Record.Cliente__r.Name}, &quot;-&quot;) &amp;
&quot; de acuerdo al siguiente detalle:&lt;br/&gt;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;Datos Generales de la Factura:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;CLIENTE:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.Cliente__r.Name}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;NO. CLIENTE:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.Cliente_seidor__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;PRECIO TOTAL DE LA FACTURA:&lt;/b&gt; &quot; &amp;
BLANKVALUE(TEXT({!$Record.Precio_Total__c}), &quot;-&quot;) &amp; &quot; &quot; &amp;
BLANKVALUE(TEXT({!$Record.Moneda__c}), &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;Org. de Venta:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.OrgVenta__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;Fecha Facturación:&lt;/b&gt; &quot; &amp;
IF(
   ISBLANK({!$Record.Fecha_Facturacin__c}),
   &quot;-&quot;,
   IF(DAY({!$Record.Fecha_Facturacin__c}) &lt; 10, &quot;0&quot;, &quot;&quot;) &amp; TEXT(DAY({!$Record.Fecha_Facturacin__c})) &amp; &quot;-&quot; &amp;
   IF(MONTH({!$Record.Fecha_Facturacin__c}) &lt; 10, &quot;0&quot;, &quot;&quot;) &amp; TEXT(MONTH({!$Record.Fecha_Facturacin__c})) &amp; &quot;-&quot; &amp;
   TEXT(YEAR({!$Record.Fecha_Facturacin__c}))
) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;OC Cliente:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.OC_Cliente__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;HES:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.HES__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>fdatosgeneralestabla</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;h3&gt;Datos Generales de la Factura&lt;/h3&gt;&quot; &amp;
&quot;&lt;table border=&apos;1&apos; cellpadding=&apos;6&apos; cellspacing=&apos;0&apos; style=&apos;border-collapse:collapse;width:100%;table-layout:fixed;word-wrap:break-word;&apos;&gt;&quot; &amp;
  &quot;&lt;tr style=&apos;background:#f2f2f2;&apos;&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;CLIENTE&lt;/b&gt;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;NO. CLIENTE&lt;/b&gt;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;PRECIO TOTAL&lt;/b&gt;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;Org. de Venta&lt;/b&gt;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;Fecha Facturación&lt;/b&gt;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;OC Cliente&lt;/b&gt;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&lt;b&gt;HES&lt;/b&gt;&lt;/td&gt;&quot; &amp;
  &quot;&lt;/tr&gt;&quot; &amp;
  &quot;&lt;tr&gt;&quot; &amp;
    &quot;&lt;td&gt;&quot; &amp; BLANKVALUE({!$Record.Cliente__r.Name}, &quot;-&quot;) &amp; &quot;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&quot; &amp; BLANKVALUE({!$Record.Cliente_seidor__c}, &quot;-&quot;) &amp; &quot;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td style=&apos;text-align:right;&apos;&gt;&quot; &amp;
       BLANKVALUE(TEXT({!$Record.Precio_Total__c}), &quot;-&quot;) &amp; &quot; &quot; &amp; BLANKVALUE(TEXT({!$Record.Moneda__c}), &quot;-&quot;) &amp;
    &quot;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&quot; &amp; BLANKVALUE({!$Record.OrgVenta__c}, &quot;-&quot;) &amp; &quot;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&quot; &amp;
      IF(
        ISBLANK({!$Record.Fecha_Facturacin__c}),
        &quot;-&quot;,
        IF(DAY({!$Record.Fecha_Facturacin__c}) &lt; 10, &quot;0&quot;,&quot;&quot;) &amp; TEXT(DAY({!$Record.Fecha_Facturacin__c})) &amp; &quot;-&quot; &amp;
        IF(MONTH({!$Record.Fecha_Facturacin__c}) &lt; 10, &quot;0&quot;,&quot;&quot;) &amp; TEXT(MONTH({!$Record.Fecha_Facturacin__c})) &amp; &quot;-&quot; &amp;
        TEXT(YEAR({!$Record.Fecha_Facturacin__c}))
      ) &amp;
    &quot;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&quot; &amp; BLANKVALUE({!$Record.OC_Cliente__c}, &quot;-&quot;) &amp; &quot;&lt;/td&gt;&quot; &amp;
    &quot;&lt;td&gt;&quot; &amp; BLANKVALUE({!$Record.HES__c}, &quot;-&quot;) &amp; &quot;&lt;/td&gt;&quot; &amp;
  &quot;&lt;/tr&gt;&quot; &amp;
&quot;&lt;/table&gt;&lt;br/&gt;&quot;</expression>
    </formulas>
