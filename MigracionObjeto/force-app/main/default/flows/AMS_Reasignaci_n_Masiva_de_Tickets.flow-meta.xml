<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <description>Actualiza al resolutor del ticket basado en el consultor seleccionado en la vista de reasignación</description>
        <name>Actualiza_Resolutor</name>
        <label>Actualiza Resolutor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_de_Tickets.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeleccionConsultor.recordId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Almacenar_Nuevo_Resolutor</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Almacenar_Nuevo_Resolutor</name>
        <label>Almacenar Nuevo Resolutor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_ListaParaActualizar</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_de_Tickets</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_de_Tickets</targetReference>
        </connector>
    </assignments>
    <dynamicChoiceSets>
        <description>Esta variable solo trae consultores activo del equipo AMS C1</description>
        <name>rcs_ConsultoresAMS</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Division</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>C1</stringValue>
            </value>
        </filters>
        <object>User</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>AMS - Reasignación Masiva de Tickets {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AMS - Reasignación Masiva de Tickets</label>
    <loops>
        <description>Este loop busca todos los tickets que un consultor tiene asignado actualmente.</description>
        <name>Loop_de_Tickets</name>
        <label>Loop de Tickets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Mis_Tickets.selectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Actualiza_Resolutor</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Actualizar_Resolutor</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Obtiene los datos de los consultores y las condiciones de los datos que traerá. Flujo se ejecutará correctamente para todos los consultores obtendrá todos sus tickets a excepción de los que están en cierre.

Conclusión: Los ticket en cierre no se pueden reasignar.</description>
        <name>Obtener_Tickets_Consultor</name>
        <label>Obtener Tickets Consultor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ReasignaciondeTickets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cierre</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Actualizar_Resolutor</name>
        <label>Actualizar Resolutor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>var_ListaParaActualizar</inputReference>
    </recordUpdates>
