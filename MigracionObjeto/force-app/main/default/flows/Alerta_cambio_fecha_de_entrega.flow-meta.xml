    <description>Se ajusta la decision de primera estimacion</description>
    <environments>Default</environments>
    <formulas>
        <name>Fechaanterior</name>
        <dataType>String</dataType>
        <expression>IF(
   ISBLANK($Record__Prior.Fecha_de_entrega__c),
   &quot;(sin valor anterior)&quot;,
  TEXT(DAY($Record__Prior.Fecha_de_entrega__c)) &amp; &quot;-&quot; &amp;
CASE(MONTH($Record__Prior.Fecha_de_entrega__c),
 1, &quot;01&quot;, 
 2, &quot;02&quot;, 
 3, &quot;03&quot;, 
 4, &quot;04&quot;, 
 5, &quot;05&quot;, 
 6, &quot;06&quot;, 
 7, &quot;07&quot;, 
 8, &quot;08&quot;, 
 9, &quot;09&quot;, 
10, &quot;10&quot;, 
11, &quot;11&quot;, 
12, &quot;12&quot;, 
&quot;&quot;
) &amp; &quot;-&quot; &amp;
TEXT(YEAR($Record__Prior.Fecha_de_entrega__c)))</expression>
    </formulas>
    <formulas>
        <name>Fechanueva</name>
        <dataType>String</dataType>
        <expression>IF(
   ISBLANK($Record.Fecha_de_entrega__c),
   &quot;(sin valor actual)&quot;,
    TEXT(DAY($Record.Fecha_de_entrega__c)) &amp; &quot;-&quot; &amp;
CASE(MONTH($Record.Fecha_de_entrega__c),
 1, &quot;01&quot;, 
 2, &quot;02&quot;, 
 3, &quot;03&quot;, 
 4, &quot;04&quot;, 
 5, &quot;05&quot;, 
 6, &quot;06&quot;, 
 7, &quot;07&quot;, 
 8, &quot;08&quot;, 
 9, &quot;09&quot;, 
10, &quot;10&quot;, 
11, &quot;11&quot;, 
12, &quot;12&quot;, 
&quot;&quot;
) &amp; &quot;-&quot; &amp;
TEXT(YEAR($Record.Fecha_de_entrega__c)))</expression>
    </formulas>
    <formulas>
        <name>Validadorcambiofecha</name>
        <dataType>Boolean</dataType>
        <expression>(ISBLANK($Record__Prior.Fecha_de_Entrega__c) &amp;&amp; NOT(ISBLANK($Record.Fecha_de_Entrega__c)))
||
(NOT(ISBLANK($Record__Prior.Fecha_de_Entrega__c)) &amp;&amp; ISBLANK($Record.Fecha_de_Entrega__c))
||
($Record__Prior.Fecha_de_Entrega__c) &lt;&gt; ($Record.Fecha_de_Entrega__c)</expression>
    </formulas>
