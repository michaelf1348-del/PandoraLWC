        <dataType>Time</dataType>
        <expression>TIMEVALUE({!$Flow.CurrentDateTime} - (4/24))</expression>
    </formulas>
    <formulas>
        <name>form_HoyAplicaTurno</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  /* 1 - DOMINGO */
  AND(WEEKDAY(TODAY()) = 1, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Domingo&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Sabado y Domingo&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;)),
  
  /* 2 - LUNES */
  AND(WEEKDAY(TODAY()) = 2, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Viernes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;)),
  
  /* 3 - MARTES */
  AND(WEEKDAY(TODAY()) = 3, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Martes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Viernes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;)),
  
  /* 4 - MIERCOLES */
  AND(WEEKDAY(TODAY()) = 4, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Miercoles&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Viernes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;)),
  
  /* 5 - JUEVES */
  AND(WEEKDAY(TODAY()) = 5, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Jueves&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Viernes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;)),
  
  /* 6 - VIERNES */
  AND(WEEKDAY(TODAY()) = 6, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Viernes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Viernes&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;)),
  
  /* 7 - SABADO */
  AND(WEEKDAY(TODAY()) = 7, OR(TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Sabado&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Sabado y Domingo&quot;, TEXT({!Evaluar_turnos.Turnos__c}) = &quot;Lunes a Domingo&quot;))
)</expression>
    </formulas>
