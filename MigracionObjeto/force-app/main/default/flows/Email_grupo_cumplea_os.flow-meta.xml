&amp; &quot;.&quot; &amp;
CASE(
MONTH(TODAY()),
1,&quot;Ene&quot;,
2,&quot;Feb&quot;,
3,&quot;Mar&quot;,
4,&quot;Abr&quot;,
5,&quot;May&quot;,
6,&quot;Jun&quot;,
7,&quot;Jul&quot;,
8,&quot;Ago&quot;,
9,&quot;Sep&quot;,
10,&quot;Oct&quot;,
11,&quot;Nov&quot;,
12,&quot;Dic&quot;,
&quot;&quot;
)</expression>
    </formulas>
