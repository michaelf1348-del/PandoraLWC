    <formulas>
        <name>fml_newname</name>
        <dataType>String</dataType>
        <expression>LEFT(
  TRIM(
    IF(NOT(ISBLANK(TEXT($Record.Servicio__c))), TEXT($Record.Servicio__c), &quot;&quot;) &amp;
    IF(
      AND(
        NOT(ISBLANK(TEXT($Record.Servicio__c))),
        NOT(ISBLANK(TEXT($Record.Tipo_de_Operacion__c)))
      ),
      &quot; - &quot;,
      &quot;&quot;
    ) &amp;
    IF(NOT(ISBLANK(TEXT($Record.Tipo_de_Operacion__c))), TEXT($Record.Tipo_de_Operacion__c), &quot;&quot;) &amp;
    IF(
      AND(
        OR(
          NOT(ISBLANK(TEXT($Record.Servicio__c))),
          NOT(ISBLANK(TEXT($Record.Tipo_de_Operacion__c)))
        ),
        NOT(ISBLANK($Record.Nombre_Cliente__r.Name))
      ),
      &quot; - &quot;,
      &quot;&quot;
    ) &amp;
    IF(NOT(ISBLANK($Record.Nombre_Cliente__r.Name)), $Record.Nombre_Cliente__r.Name, &quot;&quot;) &amp;
    IF(
      AND(
        OR(
          NOT(ISBLANK(TEXT($Record.Servicio__c))),
          NOT(ISBLANK(TEXT($Record.Tipo_de_Operacion__c))),
          NOT(ISBLANK($Record.Nombre_Cliente__r.Name))
        ),
        NOT(ISBLANK(TEXT($Record.Version__c)))
      ),
      &quot; - &quot;,
      &quot;&quot;
    ) &amp;
    IF(NOT(ISBLANK(TEXT($Record.Version__c))), TEXT($Record.Version__c), &quot;&quot;) &amp;
    IF(
      AND(
        OR(
          NOT(ISBLANK(TEXT($Record.Servicio__c))),
          NOT(ISBLANK(TEXT($Record.Tipo_de_Operacion__c))),
          NOT(ISBLANK($Record.Nombre_Cliente__r.Name)),
          NOT(ISBLANK(TEXT($Record.Version__c)))
        ),
        NOT(ISBLANK($Record.Comentario_adicional__c))
      ),
      &quot; - &quot;,
      &quot;&quot;
    ) &amp;
    IF(NOT(ISBLANK($Record.Comentario_adicional__c)), $Record.Comentario_adicional__c, &quot;&quot;)
  ),
  80
)</expression>
    </formulas>
