    <formulas>
        <name>fsaludo</name>
        <dataType>String</dataType>
        <expression>&quot;En caso de existir observaciones o comentarios, se indican aquí:&lt;br/&gt;&quot; &amp;
IF(
   ISBLANK({!$Record.Observaciones_del_Mes__c}),
   &quot;&lt;i&gt;&lt;span style=&apos;color:gray;&apos;&gt;Sin Observaciones&lt;/span&gt;&lt;/i&gt;&quot;,
   &quot;&lt;i&gt;&quot; &amp; {!$Record.Observaciones_del_Mes__c} &amp; &quot;&lt;/i&gt;&quot;
) &amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot; &amp;

&quot;Desde ya,&lt;br/&gt;&quot; &amp;
&quot;Muchas gracias por tu acostumbrada gestión.&lt;br/&gt;&lt;br/&gt;&quot; &amp;

&quot;Saludos&lt;br/&gt;&lt;br/&gt;&quot; &amp;
BLANKVALUE({!$User.FirstName}, &quot;-&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!$User.LastName}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot; &amp;

&quot;Gerente de Servicio AMS&lt;br/&gt;&quot; &amp;
BLANKVALUE({!$Organization.Name}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot; &amp;

&quot;&lt;hr/&gt;&quot; &amp;
&quot;&lt;small&gt;&lt;i&gt;Este correo fue generado automáticamente desde una casilla no monitoreada. Por favor, no respondas a este mensaje. &quot; &amp;
&quot;Si necesitas contactarte, escribe a &lt;a href=&apos;mailto:&quot; &amp;
BLANKVALUE({!$User.Email}, &quot;-&quot;) &amp;
&quot;&apos;&gt;&quot; &amp;
BLANKVALUE({!$User.Email}, &quot;-&quot;) &amp;
&quot;&lt;/a&gt;.&lt;/i&gt;&lt;/small&gt;&quot;</expression>
