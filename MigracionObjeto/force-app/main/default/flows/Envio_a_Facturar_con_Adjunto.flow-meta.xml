    <formulas>
        <name>fCabecera</name>
        <dataType>String</dataType>
        <expression>&quot;Buen día, estimado(a):&lt;br/&gt;&lt;br/&gt;&quot; &amp;
&quot;Por favor proceder a emitir facturación al cliente &quot; &amp;
BLANKVALUE({!$Record.Cliente__r.Name}, &quot;-&quot;) &amp;
&quot; de acuerdo al siguiente detalle:&lt;br/&gt;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;Datos Generales de la Factura:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;CLIENTE:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.Cliente__r.Name}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;NO. CLIENTE:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.Cliente_seidor__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;PRECIO TOTAL DE LA FACTURA:&lt;/b&gt; &quot; &amp;
BLANKVALUE(TEXT({!$Record.Precio_Total__c}), &quot;-&quot;) &amp; &quot; &quot; &amp;
BLANKVALUE(TEXT({!$Record.Moneda__c}), &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;Org. de Venta:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.OrgVenta__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;Fecha Facturación:&lt;/b&gt; &quot; &amp;
IF(
   ISBLANK({!$Record.Fecha_Facturacin__c}),
   &quot;-&quot;,
   IF(DAY({!$Record.Fecha_Facturacin__c}) &lt; 10, &quot;0&quot;, &quot;&quot;) &amp; TEXT(DAY({!$Record.Fecha_Facturacin__c})) &amp; &quot;-&quot; &amp;
   IF(MONTH({!$Record.Fecha_Facturacin__c}) &lt; 10, &quot;0&quot;, &quot;&quot;) &amp; TEXT(MONTH({!$Record.Fecha_Facturacin__c})) &amp; &quot;-&quot; &amp;
   TEXT(YEAR({!$Record.Fecha_Facturacin__c}))
) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;OC Cliente:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.OC_Cliente__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&quot; &amp;
&quot;&lt;b&gt;HES:&lt;/b&gt; &quot; &amp; BLANKVALUE({!$Record.HES__c}, &quot;-&quot;) &amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot;</expression>
    </formulas>
