    <textTemplates>
        <name>CuerpoMensajeTicketAsignado</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;html lang=&quot;es&quot;&gt;
&lt;head&gt;
	&lt;title&gt;Ticket Asignado - SEIDOR&lt;/title&gt;
&lt;/head&gt;
&lt;body style=&quot;margin: 0px; padding: 0px; background-color: rgb(243, 246, 249); font-family: &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif; height: auto; min-height: auto;&quot;&gt;
&lt;table bgcolor=&quot;#f3f6f9&quot; border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; width=&quot;100%&quot;&gt;
	&lt;tbody&gt;
		&lt;tr&gt;
			&lt;td align=&quot;center&quot; style=&quot;padding:20px 0;&quot;&gt;
			&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;max-width:600px; background-color:#ffffff; border:1px solid #e3e8ee; border-radius:10px; border-collapse:separate; overflow:hidden;&quot; width=&quot;100%&quot;&gt;
				&lt;tbody&gt;
					&lt;tr&gt;
						&lt;td height=&quot;6&quot; style=&quot;background:#263B7A; background:linear-gradient(90deg,#263B7A 0%,#66B6FF 100%); line-height:6px; font-size:6px;&quot;&gt;&amp;nbsp;&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td bgcolor=&quot;#263B7A&quot; style=&quot;padding:20px 25px;&quot;&gt;
						&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; width=&quot;100%&quot;&gt;
							&lt;tbody&gt;
								&lt;tr&gt;
									&lt;td style=&quot;color:#ffffff; font-size:18px; font-weight:600;&quot;&gt;SEIDOR &lt;span style=&quot;font-weight:300; opacity:.8; margin-left:10px;&quot;&gt;| Soporte AMS&lt;/span&gt;&lt;/td&gt;
								&lt;/tr&gt;
							&lt;/tbody&gt;
						&lt;/table&gt;
						&lt;/td&gt;
					&lt;/tr&gt;
					&lt;tr&gt;
						&lt;td style=&quot;padding:30px 25px; color:#1f2d3d;&quot;&gt;
						&lt;p style=&quot;margin:0 0 15px 0; font-size:16px;&quot;&gt;Hola &lt;strong&gt;{{{Case.OwnerFullName}}}&lt;/strong&gt;,&lt;/p&gt;

						&lt;p style=&quot;margin:0 0 20px 0; font-size:15px; line-height:1.5;&quot;&gt;Se te ha asignado el ticket &lt;strong style=&quot;color:#263B7A;&quot;&gt;{{{Case.CaseNumber}}}&lt;/strong&gt;, del cliente &lt;strong style=&quot;color:#263B7A;&quot;&gt;{{{Case.Nombre_Comercial2__c}}}&lt;/strong&gt;&lt;span style=&quot;background-color:#1E8E3E; color:#ffffff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold; margin-left:5px;&quot;&gt; ASIGNADO &lt;/span&gt;&lt;/p&gt;

						&lt;table border=&quot;0&quot; cellpadding=&quot;12&quot; cellspacing=&quot;0&quot; style=&quot;background-color:#f8fafc; border:1px solid #e3e8ee; border-radius:8px; margin-bottom:20px;&quot; width=&quot;100%&quot;&gt;
							&lt;tbody&gt;
								&lt;tr&gt;
									&lt;td style=&quot;font-size:14px;&quot;&gt;
									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;Asunto:&lt;/span&gt; &lt;strong&gt;{{{Case.Subject}}}&lt;/strong&gt;&lt;/div&gt;

									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;M&amp;oacute;dulo:&lt;/span&gt; &lt;strong&gt;{{{Case.M_dulos__c}}}&lt;/strong&gt;&lt;/div&gt;

									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;C&amp;eacute;lula:&lt;/span&gt; &lt;strong&gt;{{{Case.Grupo_AMS_Ticket__c}}}&lt;/strong&gt;&lt;/div&gt;

									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;Prioridad:&lt;/span&gt; &lt;strong&gt;{{{Case.Priority}}}&lt;/strong&gt;&lt;/div&gt;

									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;Tipo de ticket:&lt;/span&gt; &lt;strong&gt;{{{Case.RecordType}}}&lt;/strong&gt;&lt;/div&gt;

									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;Cliente:&lt;/span&gt; &lt;strong&gt;{{{Case.Nombre_Comercial2__c}}}&lt;/strong&gt;&lt;/div&gt;
									{{#if Case.ContactId}}

									&lt;div style=&quot;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;color:#53657a;&quot;&gt;Solicitante:&lt;/span&gt; &lt;strong&gt;{{{Case.Contact}}}&lt;/strong&gt;&lt;/div&gt;
									{{/if}}&lt;/td&gt;
								&lt;/tr&gt;
							&lt;/tbody&gt;
