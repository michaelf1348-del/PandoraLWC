    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Buscar_Matriz_Exclusiva</targetReference>
        </connector>
        <filterFormula>AND(
   /* 1. Condición Obligatoria: Que sea del servicio correcto */
   ISPICKVAL({!$Record.Servicio__c}, &quot;AMS-SAP&quot;),

   /* 2. Condición Detonante: Que sea Nuevo O que cambien los campos clave */
   OR(
      ISNEW(),
      ISCHANGED({!$Record.M_dulos__c}),
      ISCHANGED({!$Record.RecordTypeId})
   )
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
