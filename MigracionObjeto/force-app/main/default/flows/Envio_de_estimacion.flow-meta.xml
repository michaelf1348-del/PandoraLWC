&quot;&quot;
) &amp; &quot;-&quot; &amp;
TEXT(YEAR($Record.Fecha_de_entrega__c)))</expression>
    </formulas>
    <formulas>
        <name>Validadorcambiofecha</name>
        <dataType>Boolean</dataType>
        <expression>(ISBLANK($Record__Prior.Fecha_de_Entrega__c) &amp;&amp; NOT(ISBLANK($Record.Fecha_de_Entrega__c)))
||
(NOT(ISBLANK($Record__Prior.Fecha_de_Entrega__c)) &amp;&amp; ISBLANK($Record.Fecha_de_Entrega__c))
||
($Record__Prior.Fecha_de_Entrega__c) &lt;&gt; ($Record.Fecha_de_Entrega__c)</expression>
