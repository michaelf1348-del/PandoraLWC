<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cierre_sin_Base</fullName>
    <active>false</active>
    <description>Evita cerrar un mes sin la base</description>
    <errorConditionFormula>AND( TipoRegistroTxt__c = &apos;Cierre Mensual&apos;,   ISBLANK(Base_Mensual__c ))</errorConditionFormula>
    <errorMessage>No puede cerrar el mes sin la base mensual</errorMessage>
</ValidationRule>
