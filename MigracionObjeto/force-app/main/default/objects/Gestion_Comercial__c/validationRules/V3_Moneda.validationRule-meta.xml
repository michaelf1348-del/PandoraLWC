<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>V3_Moneda</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL( Estatus_Facturacion__c , &quot;Enviado a Facturar&quot;),
  ISBLANK(TEXT(Moneda__c))
  )</errorConditionFormula>
    <errorDisplayField>Moneda__c</errorDisplayField>
    <errorMessage>Falta la Moneda</errorMessage>
</ValidationRule>
