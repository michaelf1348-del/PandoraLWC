<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>V4_OrganizacionVenta</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL( Estatus_Facturacion__c , &quot;Enviado a Facturar&quot;),
   ISBLANK(OrgVenta__c)
)</errorConditionFormula>
    <errorDisplayField>OrgVenta__c</errorDisplayField>
    <errorMessage>Falta Org. Venta</errorMessage>
</ValidationRule>
