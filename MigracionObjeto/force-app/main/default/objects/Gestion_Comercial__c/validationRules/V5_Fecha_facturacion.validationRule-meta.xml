<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>V5_Fecha_facturacion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL( Estatus_Facturacion__c , &quot;Enviado a Facturar&quot;),
ISBLANK(Fecha_Facturacin__c)
)</errorConditionFormula>
    <errorDisplayField>Fecha_Facturacin__c</errorDisplayField>
    <errorMessage>Falta la Fecha de Facturación</errorMessage>
</ValidationRule>
