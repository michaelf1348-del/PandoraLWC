<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>V1_Cliente_Seidor</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL( Estatus_Facturacion__c , &quot;Enviado a Facturar&quot;),
  ISBLANK(Cliente_seidor__c)
)</errorConditionFormula>
    <errorDisplayField>Cliente_seidor__c</errorDisplayField>
    <errorMessage>No existe cliente Seidor registrado</errorMessage>
</ValidationRule>
