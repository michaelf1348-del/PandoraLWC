<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>E3_Formato_Email_Adicional_2</fullName>
    <active>true</active>
    <description>Evita crear con email vacio en usuario</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Email_Adicional_2__c)),
  NOT(
    REGEX(
      TRIM(Email_Adicional_2__c),
      &quot;(?!\\.)[A-Za-z0-9._%+-]+@(?:(?!-)[A-Za-z0-9-]+(?&lt;!-)\\.)+[A-Za-z]{2,}$&quot;
    )
  )
)</errorConditionFormula>
    <errorDisplayField>Email_Adicional_2__c</errorDisplayField>
    <errorMessage>Formato inválido en Email Adicional 2 (ej: usuario@dominio.com)</errorMessage>
</ValidationRule>
