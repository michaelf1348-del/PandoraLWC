<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>E1_Formato_Email_Adicional_1</fullName>
    <active>true</active>
    <description>Evita crear con email vacio en usuario</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Email_Adicional_1__c)),
  NOT(
    REGEX(
      TRIM(Email_Adicional_1__c),
      &quot;^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$&quot;
    )
  )
)</errorConditionFormula>
    <errorDisplayField>Email_Adicional_1__c</errorDisplayField>
    <errorMessage>Formato inválido en Email Adicional 1 (ej: usuario@dominio.com)</errorMessage>
</ValidationRule>
