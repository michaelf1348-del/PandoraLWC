<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Lista de Tickets (Custom)</masterLabel>
    <description>Lista relacionada personalizada de Tickets (Case) con filtrado dinámico de tipos de registro según la cuenta.</description>
    <targets>
        <!-- Arrastrable en Lightning Record Pages (Account) -->
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <!-- Restringimos el componente para que solo aparezca en páginas de Account -->
            <objects>
                <object>Account</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
