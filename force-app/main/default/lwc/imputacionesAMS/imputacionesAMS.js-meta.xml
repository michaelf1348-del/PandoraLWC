<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Imputaciones AMS</masterLabel>
    <description>Herramienta de imputación masiva para AMS SAP</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordAction</target>
        <target>lightning__Tab</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>ScreenAction</actionType>
            <objects>
                <object>Case</object>
            </objects>
        </targetConfig>
        
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordIds" type="String[]" label="IDs de Casos" description="Lista de tickets seleccionados en la vista de lista"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>