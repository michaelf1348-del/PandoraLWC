<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Monitor SLA Equipo Resolutores</masterLabel>
    <description>Panel de monitoreo SLA: mis tickets, apoyos y equipo, con acciones rapidas.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__UtilityBar</target>
        <target>lightning__AppPage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__UtilityBar,lightning__AppPage">
            <property
                name="autoRefreshMinutes"
                label="Auto-refresh (minutos)"
                type="Integer"
                default="5"
                description="Cada cuantos minutos refrescar el listado automaticamente. 0 desactiva." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
